{
  "manifest_version": 3,
  "name": "Skip Sponsors",
  "version": "0.1.0",
  "description": "Automatically skips sponsored segments in YouTube videos using the SponsorBlock database.",
  "permissions": ["storage"],
  "host_permissions": ["https://sponsor.ajay.app/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Skip Sponsors",
    "default_popup": "popup/popup.html"
  }
}
